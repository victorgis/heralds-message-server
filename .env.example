PORT=4000

# Public URL for building absolute stream links returned to the frontend.
PUBLIC_API_BASE_URL=https://heralds-message-server-production.up.railway.app

# CORS origins for your frontend.
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5173

# Telegram bot credentials.
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash

# Local Bot API server launched inside the same container.
TELEGRAM_BOT_API_BASE=http://127.0.0.1:8081
TELEGRAM_BOT_API_PORT=8081
TELEGRAM_BOT_API_DIR=/var/lib/telegram-bot-api

# Supabase metadata source.
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
TELEGRAM_TEACHINGS_TABLE=telegram_teachings

# Optional direct Supabase Storage audio.
SUPABASE_AUDIO_BUCKET=audio-messages
SUPABASE_STORAGE_PUBLIC=false
SUPABASE_STORAGE_SIGNED_URL_TTL=3600

# Disk cache for Telegram files downloaded through the local server.
CACHE_DIR=./cache
CACHE_TTL_SECONDS=86400
CACHE_MAX_BYTES=2147483648
CACHE_CLEANUP_INTERVAL_SECONDS=900
